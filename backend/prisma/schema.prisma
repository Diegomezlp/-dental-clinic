generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ASSISTANT
}

model Patient {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String?  @unique
  phone        String
  birthDate    DateTime?
  address      String?
  allergies    String?
  medications  String?
  medicalNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
  toothRecords ToothRecord[]
  quotes       Quote[]
  payments     Payment[]
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id        Int           @id @default(autoincrement())
  patientId Int
  quoteId   Int?
  amount    Float
  method    PaymentMethod @default(CASH)
  notes     String?
  userId    Int?
  createdAt DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  quote   Quote?  @relation(fields: [quoteId], references: [id])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  items InventoryItem[]
}

model InventoryItem {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  unit       String   @default("unidad")
  stock      Int      @default(0)
  minStock   Int      @default(0)
  active     Boolean  @default(true)
  supplierId Int?
  createdAt  DateTime @default(now())

  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  movements StockMovement[]
}

enum MovementType {
  IN
  OUT
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  itemId    Int
  type      MovementType
  quantity  Int
  notes     String?
  userId    Int?
  createdAt DateTime     @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  category    String   @default("Otros")
  amount      Float
  userId      Int?
  createdAt   DateTime @default(now())
}

model Treatment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items QuoteItem[]
}

enum QuoteStatus {
  DRAFT
  ACCEPTED
  COMPLETED
  REJECTED
}

model Quote {
  id        Int         @id @default(autoincrement())
  patientId Int
  status    QuoteStatus @default(DRAFT)
  notes     String?
  createdAt DateTime    @default(now())

  patient Patient     @relation(fields: [patientId], references: [id])
  items   QuoteItem[]
  payments Payment[]
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  treatmentId Int
  tooth       Int?
  quantity    Int     @default(1)
  price       Float
  done        Boolean @default(false)

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  treatment Treatment @relation(fields: [treatmentId], references: [id])
}

enum ToothCondition {
  HEALTHY
  CAVITY
  FILLING
  CROWN
  ROOT_CANAL
  IMPLANT
  EXTRACTED
  PENDING
}

model ToothRecord {
  id        Int            @id @default(autoincrement())
  patientId Int
  tooth     Int
  condition ToothCondition
  notes     String?
  userId    Int?
  createdAt DateTime       @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model Appointment {
  id          Int               @id @default(autoincrement())
  date        DateTime
  duration    Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  patientId   Int
  dentistId   Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  dentist User    @relation(fields: [dentistId], references: [id])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}
